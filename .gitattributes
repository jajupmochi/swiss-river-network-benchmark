# Line endings — keep LF in the repo for reproducibility across platforms.
* text=auto eol=lf
*.sh       text eol=lf
*.py       text eol=lf
*.md       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.cff      text eol=lf

# Windows-only
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Jupyter notebooks — treat as text so diffs are readable, but disable default merge.
*.ipynb    text merge=union linguist-language=Python

# Generated docs / site
site/**    linguist-documentation
docs/**    linguist-documentation

# Language detection overrides
swissrivernetwork/benchmark/outputs/**  linguist-generated=true
swissrivernetwork/benchmark/dump/**     linguist-generated=true
swissrivernetwork/benchmark/wandb/**    linguist-generated=true

# Git LFS — large binary artefacts.
checkpoint/   filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.csv         filter=lfs diff=lfs merge=lfs -text
*.png         filter=lfs diff=lfs merge=lfs -text
